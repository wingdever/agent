data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3

# ===== 环境变量 / 密钥 =====
.env
.env.*
*.env
.envrc

# ===== 构建产物（Electron / 前端打包输出） =====
dist/
out/
release/
build/
.vite/
*.exe
*.dmg
*.AppImage
*.snap
*.deb
*.rpm

# ===== 日志 =====
*.log
npm-debug.log*
pnpm-debug.log*

# ===== 操作系统 / 编辑器 =====
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

