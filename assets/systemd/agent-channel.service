[Unit]
Description=Standalone channel service (one instance)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/wing/Projects/agent
Environment=NODE_BIN=/usr/bin/node
# The service owns the platform socket + SQLite history. It does not run an
# agent; core subscribes to /messages/subscribe and /interactions/subscribe over
# HTTP/SSE and sends via /proactive. /health is unauthenticated; the other
# endpoints require the shared bearer token.
Environment=CHANNEL_RUN_ID=alice-qq
EnvironmentFile=-/home/wing/Projects/agent/user/channel-daemon.env
ExecStart=/bin/bash /home/wing/Projects/agent/scripts/channel-daemon.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
